{
  "name": "mulqi-websearch",
  "version": "1.0.0",
  "description": "Mulqi Websearch — one search/fetch provider for DeepSeek Harness that merges free-search (13 engines), @liustack/modsearch, dsh-web-monid and dsh-web-monid-fallback behind a single ctx.web provider with round-robin rotation and bounded fallback.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "test",
    "cordis.patch.yml",
    "README.md",
    "NOTES.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "web-search",
    "search",
    "round-robin",
    "fallback",
    "duckduckgo",
    "bing",
    "searxng",
    "tavily",
    "exa",
    "perplexity",
    "modsearch",
    "monid"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mulqizamzam/mulqi-websearch.git"
  },
  "homepage": "https://github.com/mulqizamzam/mulqi-websearch#readme",
  "bugs": {
    "url": "https://github.com/mulqizamzam/mulqi-websearch/issues"
  },
  "author": "mulqizamzam",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node --check lib/backends.js && node --check lib/scheduler.js && node --check lib/index.js",
    "test": "node --test test/regression.test.mjs",
    "verify": "npm run check && npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-web": ">=0.1.1-rc.2"
  },
  "dependencies": {
    "dsh-free-search": "link:../dsh-free-search-chain"
  }
}
